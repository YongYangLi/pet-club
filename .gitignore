# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 打包产物 ----
# dist/ 里是 25MB 的 exe 和 latest.json：发布走 COS，不进版本库。
build/
dist/
*.spec

# ---- 本机运行数据 ----
# 聊天里收到/发出的附件（config.files_dir），只在当前这台机器上有意义。
petclub-data/
*.log

# ---- 做图用的原图 ----
# 324MB 的定妆图/抠图/候选稿，只在出 assets 时用到；运行时一个字节都不读。
素材/

# ---- 生成过程中的预览图 ----
# assets/roles、assets/stickers 是运行必需的，别把整个 assets 忽略掉。
assets/_gen/

# ---- 临时文件 ----
.tmp/
.tmp_*
*.tmp
*.part
*.old
*.new
*.new.json

# ---- 编辑器 / 工具 ----
.workbuddy/
.vscode/
.idea/
.DS_Store
Thumbs.db
